# Dependencies
node_modules/

# Environment files (never commit secrets) — only *.example is tracked
.env
.env.*
!.env.example
!.env.*.example

# Build output
dist/
dist-ssr/
build/

# Logs
*.log
npm-debug.log*

# OS/editor
.DS_Store
.vscode/*
!.vscode/extensions.json
.idea

# Prisma
backend/prisma/dev.db

# User uploads (Remix source images) — transient, deleted after processing
backend/uploads/

# Redis snapshot, if a local redis-server is ever started from a repo directory
dump.rdb
