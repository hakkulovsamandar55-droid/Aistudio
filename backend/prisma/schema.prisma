generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum GenerationType {
  IMAGE
  VIDEO
  VOICE
  MUSIC
  SCRIPT
}

enum ProjectStatus {
  PLANNING
  RUNNING
  COMPLETED
  PARTIAL
  FAILED
}

enum GenerationStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum CreditTransactionType {
  PURCHASE
  GENERATION_IMAGE
  GENERATION_VIDEO
  SIGNUP_BONUS
  REFUND
  ADMIN_ADJUSTMENT
  REFERRAL_BONUS
  DAILY_BONUS
}

enum Role {
  USER
  ADMIN
}

enum PlanType {
  FREE
  PRO
}

model User {
  id               String    @id @default(uuid())
  email            String    @unique
  password         String
  name             String
  credits          Int       @default(10)
  role             Role      @default(USER)
  plan             PlanType  @default(FREE)
  planExpiresAt    DateTime? @map("plan_expires_at")
  isActive         Boolean   @default(true) @map("is_active")
  referralCode     String    @unique @map("referral_code")
  referredById     String?   @map("referred_by_id")
  referredBy       User?     @relation("Referrals", fields: [referredById], references: [id], onDelete: SetNull)
  referrals        User[]    @relation("Referrals")
  lastDailyBonusAt DateTime? @map("last_daily_bonus_at")
  stripeCustomerId String?   @map("stripe_customer_id")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  generations         Generation[]
  projects            Project[]
  creditTransactions  CreditTransaction[]
  passwordResetTokens PasswordResetToken[]

  @@map("users")
}

model Generation {
  id             String           @id @default(uuid())
  userId         String           @map("user_id")
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId      String?          @map("project_id")
  project        Project?         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  // Which slot this asset fills inside its project (script, cover, main, ...).
  role           String?
  type           GenerationType
  userPrompt     String           @map("user_prompt")
  enhancedPrompt String?          @map("enhanced_prompt")
  style          String?
  status         GenerationStatus @default(PENDING)
  resultUrl      String?          @map("result_url")
  // Text modules (script, caption, hashtags) produce prose, not a file.
  resultText     String?          @map("result_text")
  creditsUsed    Int              @default(0) @map("credits_used")
  provider       String
  errorMessage   String?          @map("error_message")
  isFavorite     Boolean          @default(false) @map("is_favorite")
  isPublic       Boolean          @default(false) @map("is_public")
  deletedAt      DateTime?        @map("deleted_at")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  @@index([userId])
  @@index([projectId])
  @@index([isPublic, status])
  @@map("generations")
}

/// A Magic Mode run: one natural-language request, its analysed intent, the
/// plan derived from it, and every asset produced along the way.
model Project {
  id          String        @id @default(uuid())
  userId      String        @map("user_id")
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  userRequest String        @map("user_request")
  goal        String
  intent      Json
  plan        Json
  status      ProjectStatus @default(PLANNING)
  creditsUsed Int           @default(0) @map("credits_used")
  deletedAt   DateTime?     @map("deleted_at")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  generations Generation[]

  @@index([userId])
  @@map("projects")
}

model CreditTransaction {
  id              String                @id @default(uuid())
  userId          String                @map("user_id")
  user            User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount          Int
  type            CreditTransactionType
  description     String
  stripePaymentId String?               @map("stripe_payment_id")
  createdAt       DateTime              @default(now()) @map("created_at")

  @@index([userId])
  @@map("credit_transactions")
}

model CreditPackage {
  id            String   @id @default(uuid())
  name          String
  credits       Int
  priceUsd      Float    @map("price_usd")
  stripePriceId String   @unique @map("stripe_price_id")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")

  @@map("credit_packages")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("password_reset_tokens")
}

/// Per-provider credentials and availability, editable from the admin panel.
/// `apiKeyEnc` holds AES-256-GCM ciphertext — the plaintext key is never
/// stored and never leaves the server.
model ProviderSetting {
  id        String   @id @default(uuid())
  provider  String   @unique
  apiKeyEnc String?  @map("api_key_enc")
  baseUrl   String?  @map("base_url")
  /// Off by default so an expensive vendor can sit configured-but-idle until
  /// the economics justify switching it on.
  isEnabled Boolean  @default(false) @map("is_enabled")
  notes     String?
  updatedAt DateTime @updatedAt @map("updated_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("provider_settings")
}

model Announcement {
  id        String   @id @default(uuid())
  message   String
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("announcements")
}
