generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum GenerationType {
  IMAGE
  VIDEO
}

enum GenerationStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum CreditTransactionType {
  PURCHASE
  GENERATION_IMAGE
  GENERATION_VIDEO
  SIGNUP_BONUS
  REFUND
  ADMIN_ADJUSTMENT
  REFERRAL_BONUS
  DAILY_BONUS
}

enum Role {
  USER
  ADMIN
}

model User {
  id               String    @id @default(uuid())
  email            String    @unique
  password         String
  name             String
  credits          Int       @default(10)
  role             Role      @default(USER)
  isActive         Boolean   @default(true) @map("is_active")
  referralCode     String    @unique @map("referral_code")
  referredById     String?   @map("referred_by_id")
  referredBy       User?     @relation("Referrals", fields: [referredById], references: [id], onDelete: SetNull)
  referrals        User[]    @relation("Referrals")
  lastDailyBonusAt DateTime? @map("last_daily_bonus_at")
  stripeCustomerId String?   @map("stripe_customer_id")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  generations         Generation[]
  creditTransactions  CreditTransaction[]
  passwordResetTokens PasswordResetToken[]

  @@map("users")
}

model Generation {
  id             String           @id @default(uuid())
  userId         String           @map("user_id")
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type           GenerationType
  userPrompt     String           @map("user_prompt")
  enhancedPrompt String?          @map("enhanced_prompt")
  style          String?
  status         GenerationStatus @default(PENDING)
  resultUrl      String?          @map("result_url")
  creditsUsed    Int              @default(0) @map("credits_used")
  provider       String
  errorMessage   String?          @map("error_message")
  isFavorite     Boolean          @default(false) @map("is_favorite")
  isPublic       Boolean          @default(false) @map("is_public")
  deletedAt      DateTime?        @map("deleted_at")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  @@index([userId])
  @@index([isPublic, status])
  @@map("generations")
}

model CreditTransaction {
  id              String                @id @default(uuid())
  userId          String                @map("user_id")
  user            User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount          Int
  type            CreditTransactionType
  description     String
  stripePaymentId String?               @map("stripe_payment_id")
  createdAt       DateTime              @default(now()) @map("created_at")

  @@index([userId])
  @@map("credit_transactions")
}

model CreditPackage {
  id            String   @id @default(uuid())
  name          String
  credits       Int
  priceUsd      Float    @map("price_usd")
  stripePriceId String   @unique @map("stripe_price_id")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")

  @@map("credit_packages")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("password_reset_tokens")
}

model Announcement {
  id        String   @id @default(uuid())
  message   String
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("announcements")
}
