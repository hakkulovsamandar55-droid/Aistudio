# Server
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/ai_studio?schema=public"

# JWT
JWT_SECRET=change_this_to_a_long_random_secret
JWT_REFRESH_SECRET=change_this_to_a_different_long_random_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Required to store provider API keys entered in the admin panel — without it,
# admin key updates are refused (env-only providers keep working). Generate
# with: openssl rand -hex 32
SETTINGS_ENCRYPTION_KEY=

# AI Providers
# Every provider below can also be set from Admin > Providers, which takes
# precedence over these values and needs no redeploy to change. Leave a
# provider unset here AND unconfigured in the admin panel and the gateway
# falls back to the mock implementation, so the whole pipeline still runs
# end to end with no credentials at all.
IMAGE_PROVIDER=mock
VIDEO_PROVIDER=mock
VOICE_PROVIDER=mock
MUSIC_PROVIDER=mock
TEXT_PROVIDER=mock

OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_ENHANCER_MODEL=gpt-4o-mini
OPENAI_TEXT_MODEL=gpt-4o-mini

# --- Video quality tiers (see services/ai-gateway/videoTiers.js) -------------
# low -> Wan, standard -> Kling, better -> Runway, ultra -> Veo.
# A tier whose key is missing degrades to whichever video provider is
# configured, so you can enable them one at a time.

# tier: better
RUNWAY_API_KEY=
RUNWAY_API_BASE_URL=https://api.dev.runwayml.com/v1

# tier: standard
KLING_API_KEY=
KLING_API_BASE_URL=https://api.klingai.com/v1

# tier: low
WAN_API_KEY=
WAN_API_BASE_URL=https://dashscope-intl.aliyuncs.com/api/v1

# tier: ultra
VEO_API_KEY=
VEO_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# When true, a failed tier retries once on the next cheaper tier instead of
# erroring. Off by default: it delivers lower quality than the user paid for.
VIDEO_TIER_FALLBACK=false

# Voice / music
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2

SUNO_API_KEY=
SUNO_API_BASE_URL=https://api.sunoapi.org/api/v1

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Initial admin user (created by `npx prisma db seed` if set)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Google Sign-In. The frontend gets an ID token from Google Identity Services
# (VITE_GOOGLE_CLIENT_ID must be the same client id) and this server verifies
# it as the token's audience — CLIENT_SECRET isn't needed for that and is
# only here for a future server-side OAuth flow. Leave both unset to disable
# the "Google bilan kirish" button; POST /api/auth/google returns 503 until
# GOOGLE_CLIENT_ID is set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Background job queue. With REDIS_URL set, video generation runs in a
# separate worker process (`npm run worker`) that survives an API restart —
# this is what production should use. Leave it empty and jobs run in-process
# instead, which is fine for local dev but loses anything still rendering
# when the process stops. QUEUE_DRIVER=inline forces that fallback even when
# Redis is reachable.
REDIS_URL=
QUEUE_DRIVER=
# How many video renders one worker handles at once.
WORKER_CONCURRENCY=3

# File storage. `local` writes to backend/uploads/ and serves it from
# /uploads — fine for dev, but those files die with the server and are
# invisible to a second instance. Production should use `s3`: any
# S3-compatible bucket works, and Cloudflare R2 or DigitalOcean Spaces are
# the sensible picks because neither charges for egress (generated video is
# almost all egress).
#
# With the s3 driver, generation results are also copied out of the
# provider's CDN into the bucket — provider URLs expire within the hour, so
# without this a user's library slowly turns into broken links.
STORAGE_DRIVER=local
# Only needed by the local driver, to build absolute /uploads URLs.
API_PUBLIC_URL=http://localhost:4000
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Public/CDN base URL for the bucket. Leave empty to hand out signed URLs
# instead (S3_SIGNED_URL_TTL seconds, default 7 days).
S3_PUBLIC_URL=
S3_SIGNED_URL_TTL=

# Transactional email (Resend — https://resend.com). Used for password reset,
# the welcome mail and payment receipts. Leave the key empty and nothing is
# sent: the app still works, and POST /auth/forgot-password returns the raw
# token inline (outside production only) so the flow stays testable. Once a
# key IS set, the token is never returned in a response — the only way to it
# is the user's inbox.
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM_ADDRESS="AI Studio <onboarding@resend.dev>"
