# Config used by `npm test`. Copy to .env.test and point DATABASE_URL at a
# throwaway database — the suite TRUNCATEs every table between tests.
NODE_ENV=test
PORT=4999

DATABASE_URL="postgresql://aistudio:aistudio@localhost:5432/ai_studio_test?schema=public"

JWT_SECRET=test_secret_not_used_outside_tests
JWT_REFRESH_SECRET=test_refresh_secret_not_used_outside_tests
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Mock providers keep the suite offline and free.
IMAGE_PROVIDER=mock
VIDEO_PROVIDER=mock

FRONTEND_URL=http://localhost:5173
